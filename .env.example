# ============================================================================
# .env.example — NAMUNA. `.env` deb nusxa oling va qiymatlarni to'ldiring:
#
#   cp .env.example .env && chmod 600 .env
#
# `.env` HECH QACHON git ga ham, Docker rasmiga ham tushmaydi (.gitignore,
# .dockerignore). Compose uni ish vaqtida beradi. Har sozlamaning ma'nosi va
# standart qiymati — `app/config.py` (yagona manba).
#
# Parollar: faqat harf va raqam (ular URL ichiga tushadi — @ : / buzadi):
#   openssl rand -hex 24
# ============================================================================

# ── Baza (docker-compose.yml: `db` xizmati — tender-v2 ning O'Z bazasi) ─────
POSTGRES_DB=tender_v2
POSTGRES_USER=tender_owner          # jadvallar EGASI — faqat `migrate` ishlatadi
POSTGRES_PASSWORD=
# Ilova (api/worker/sender) shu MINIMAL huquqli rol bilan ulanadi. Rolni va
# huquqlarini `migrate` yaratadi (parol o'zgarsa — keyingi `up` da yangilanadi).
APP_DB_USER=tender_ai
APP_DB_PASSWORD=

# Compose'dan TASHQARIDA (qo'lda, mahalliy) ishga tushirishda — to'liq manzil:
# DATABASE_URL=postgresql://tender_ai:PAROL@127.0.0.1:5432/tender_v2
#   yoki bo'laklarga bo'lib: DB_HOST / DB_PORT / DB_DATABASE / DB_USERNAME / DB_PASSWORD
# (compose ichida DATABASE_URL avtomatik beriladi — bu yerdagisi e'tiborsiz)

# ── Rasm (CI chiqargan) ─────────────────────────────────────────────────────
# IMAGE=ghcr.io/shaffofai/shaffofai-tender-v2
TAG=latest                          # rollback: TAG=sha-<commit>

# ── 1) KIRUVCHI API — tender tizimi bizga fayl ma'lumotini yozadi ───────────
# Kalitlarni BIZ beramiz. Yangi qiymat:  openssl rand -hex 20
KIRUVCHI_LOGIN=
KIRUVCHI_PAROL=
MAX_TOPLAM=500                      # bitta so'rovdagi YOYILGAN fayllar chegarasi (himoya)
DOCS_ENABLED=0                      # /docs, /redoc, /openapi.json — ishlab chiqarishda 0
# O'tish davri (docker-compose.edge.yml): API shu manzilda ochiladi
EDGE_BIND=127.0.0.1                 # serverda: 192.168.100.60 — HECH QACHON 0.0.0.0
EDGE_PORT=8084

# ── 2) CHIQUVCHI — biz tender tizimiga verdikt yuboramiz ────────────────────
# ⚠️ FAQAT https://  (Basic Auth parolni base64 bilan o'raydi — bu SHIFR EMAS;
#    80-port javob ham bermaydi, 2026-09-23 o'lchovi). http:// bo'lsa
#    yuboruvchi ishga tushmaydi (FATAL). Yagona istisno — 127.0.0.1 (sinov).
TENDER_API_URL=https://api.shaffofxarid.uz/api/integration/ai/set-result
TENDER_API_LOGIN=
TENDER_API_PAROL=
# Bizning kodlar: 1 qabul, 2 rad, 3 aynan nusxa, 4 TEXNIK (tekshirib bo'lmadi,
# taslim — rad EMAS). 2026-09-24 (buyurtmachi): TO'RTALASI HAM yuboriladi.
# Sherik validatori hali `in:1,2` bo'lsa 3/4 ga 422 beradi — xabar YO'QOLMAYDI
# (holat=1, sabab aniq yoziladi), keyin: python yuboruvchi.py --qayta-och 3,4
# 0→2 va 4→2 xaritasi TAQIQLANGAN (texnik holat rad emas — OLTIN QOIDA).
TENDER_QABUL_STATUSLAR=1,2,3,4
TENDER_STATUS_XARITA=
TENDER_TIMEOUT=30
YUBORISH_OQIM=20                    # parallellik (ular 300 ko'taradi — zaxira ataylab)
YUBORISH_TOPLAM=100
YUBORISH_MAX_URINISH=3              # ⚠️ 3 dan OSHMASIN (yn_urinish_chk)
CRON_INTERVAL=180                   # navbat bo'sh bo'lganda kutish, soniya
# Texnik xabar (status=4) — eng ehtiyotkor yo'l, uchta himoya:
YUBORISH_TEXNIK_KECHIKISH=21600     # H1: 6 soat — operator toshqinni sezib --requeue qilsin
TEXNIK_TOSHQIN_CHEGARA=50           # H2: shundan ko'p o'lik fayl = TIZIM nosozligi, yozilmaydi
YUBORISH_TEXNIK_LEASE=1800          # sekin fayl ustida worker hamon ishlayotgan bo'lishi mumkin
TEXNIK_YUBORISH=1                   # 0 — texnik xabarlar butunlay o'chadi (favqulodda)

# ── 3) Fayllar va havola oq ro'yxati (SSRF himoyasi) ────────────────────────
# Nisbiy `link` (8638/excel2/9518/fayl.xls) yuklashdan oldin shu manzilga qo'shiladi.
FILE_BASE_URL=https://apisitender.mc.uz/storage/
# Yo'naltirishdan KEYINGI host ham tekshiriladi. Mahalliy sinov: ...,127.0.0.1
RUXSAT_HOSTLAR=apisitender.mc.uz

# ── Ixtiyoriy (kodda standart qiymati bor — app/config.py) ──────────────────
# POLL_INTERVAL=5             # bo'sh navbatni qayta tekshirish, soniya
# LEASE_MINUTES=30            # SHART: yuklab olish + o'qish budjetidan KATTA
# MAX_ATTEMPTS=5              # texnik xatoda necha marta (keyin «o'lik», status 4)
# RETRY_BASE_SECONDS=60       # texnik xatodan keyin kutish (eksponensial)
# RETRY_MAX_SECONDS=900
# RECONNECT_MAX_WAIT=60
# DISCOVERY_INTERVAL=300      # navbatni to'liq qayta skanerlash
# ETALON_KUTISH_INTERVAL=600  # shablon kutilayotgan fayl qanchada bir qayta ko'riladi
# ETALON_KUTISH_MAX_SOAT=72   # shuncha soat shablon kelmasa — o'lik ro'yxatiga
# ETALON_CACHE_MAX_MB=2000    # etalon keshi chegarasi (LRU)
# MAX_DOWNLOAD_MB=900         # bundan katta fayl YUKLAB OLINMAYDI
# DOWNLOAD_TOTAL_TIMEOUT=600  # LEASE_MINUTES dan KICHIK bo'lsin
# DOWNLOAD_TIMEOUT=60
# DOWNLOAD_RETRIES=3
# DOWNLOAD_HEADERS={"Authorization": "Bearer ..."}
# YUBORISH_RETRY_BAZA=300     # yuborish backoff'i: 300 s → 600 s
# YUBORISH_RETRY_MAKS=3600
# YUBORISH_TASHLANDI_CHEGARA=20   # shundan oshsa sender --health QIZIL
# LOG_LEVEL=INFO
#
# Xotira chegaralari (compose): WORKER_MEMORY=4G, API_MEMORY=512M, SENDER_MEMORY=256M
#
# Tekshiruv dvigatelining o'z xavfsizlik chegaralari (tender_engine o'qiydi):
# MAX_SHEET_ROWS=200000  MAX_SHEET_COLS=2000  MAX_MERGE_CELLS=50000
# MAX_XLSX_PART_BYTES=209715200  MAX_XLSX_QIRQISH_BYTES=1073741824
# ETALON_PARSE_CACHE=6  TIKLASH_YOQ=1  (va tiklash_* modullaridagi TIKLASH_*/NOL_BAYT_*)
#
# OLIB TASHLANGAN (2026-09-29) — qo'yilsa xizmat aniq xabar bilan to'xtaydi:
#   JOBS_TABLE / TEMPLATES_TABLE / JOBS_PK / JOBS_GROUP_COL — sxema endi qat'iy
#   ETALON_DISK_FALLBACK=1 — diskdagi etalon zaxirasi yo'q (ETALON_DIR e'tiborsiz)
